# Your cloro API key (https://cloro.dev) — used to submit scrape tasks
CLORO_API_KEY=sk_live_...

# Postgres connection string. Use the POOLED string if your provider
# offers one (on Vercel this is set for you).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# The one secret this deployment needs. Clients send it as
# "Authorization: Bearer <CRON_SECRET>" to reach the REST API and the MCP
# endpoint, Vercel Cron sends it automatically to GET /api/cron, and the
# webhook token is derived from it. Generate one: openssl rand -hex 32
#
# It is called CRON_SECRET because Vercel Cron can only authenticate
# through a variable with that exact name.
CRON_SECRET=

# Optional. Set this if you want the API token to be different from the
# cron secret; when set, it replaces CRON_SECRET for REST and MCP auth.
# APP_API_KEY=

# Optional. Public base URL of this deployment, used to build the webhook
# callback URL. On Vercel this is derived automatically from
# VERCEL_PROJECT_PRODUCTION_URL — set it only for other hosts.
# APP_URL=https://tracker.example.com

# Optional. If your cloro organization has webhook signing enabled, set the
# signing secret here to verify X-Cloro-Signature on incoming webhooks.
# CLORO_WEBHOOK_SECRET=

# Optional. Override the cloro API base URL (default https://api.cloro.dev).
# CLORO_API_URL=https://api.cloro.dev
